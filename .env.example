# Copy to .env and fill in. `.env` is gitignored.

# Optional: enables the AI narrative. Detection and confidence scores work without it.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Signs the auth cookie. Any long random string for local dev.
JWT_SECRET=dev-secret-change-me

# v1 leftover, not read by anything: v2 has no seeded account. Register an
# organization in the UI instead.
DEMO_EMAIL=analyst@logmonitor.dev
DEMO_PASSWORD=logmonitor123

# Postgres (matches docker-compose defaults)
POSTGRES_USER=logmonitor
POSTGRES_PASSWORD=logmonitor
POSTGRES_DB=logmonitor

# --- Phase 1b: authentication hardening ------------------------------------

# Edge HTTP Basic Auth. A coarse shared gate in front of everything, so
# scanners never reach the login form. NOT the security boundary.
# Generate all three values with: scripts/gen_edge_auth.sh <password>
EDGE_AUTH_ENABLED=false
EDGE_AUTH_USER=ops
EDGE_AUTH_PASS_HASH=          # argon2id, read by the Go gateway
EDGE_AUTH_PASS_SHA256=        # sha256 hex, read by Next.js middleware

# Encrypts TOTP secrets at rest. 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# Losing this key means every enrolled user must re-enrol.
TOTP_ENCRYPTION_KEY=

# Session cookie Secure flag. Defaults to true in code; set false only for
# local http development.
COOKIE_SECURE=false

LOGIN_RATE_LIMIT_ENABLED=true
