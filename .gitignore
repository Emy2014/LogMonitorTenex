# Timestamped backups the deploy scripts leave behind. These hold real
# secrets, and the original pattern above did not match them.
.env.bak-*
.env.backup*

# Pre-v2 copies kept on disk for quick rollback. Git history already has
# them, so they do not belong in the tree.
*.v1-backup
*.v1-backup.md
docker-compose.yml.v1-backup

# Uploads (local dev)
api/uploads/

# OS
.DS_Store

# Python virtualenvs
worker/.venv/
